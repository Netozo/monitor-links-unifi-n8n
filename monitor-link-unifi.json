{
  "name": "monitor-links-unifi",
  "nodes": [
    {
      "parameters": {
        "content": "## Monitoramento de Links - Gateways Unifi\n\n**Fluxo:**\n1. Busca sites da Unifi\n2. Limpa dados de WANs\n3. Busca hostname de cada host\n4. Filtra problemas (state != connected OU wanUptime <= 80%)\n5. Verifica se já enviou alerta igual\n6. Envia no WhatsApp apenas se: tem problemas E (mensagem diferente OU passaram 2h)",
        "height": 552,
        "width": 2576,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -1280,
        -64
      ],
      "typeVersion": 1,
      "id": "39ba4cf4-e7bc-4e31-ba2e-e370052f47ad",
      "name": "Documentacao"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1216,
        256
      ],
      "id": "c2dd17f8-5eee-4d75-bd1f-ffe118c9078a",
      "name": "Disparador_a_Cada_30min"
    },
    {
      "parameters": {
        "url": "https://api.ui.com/v1/sites",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $json.token_unifi }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -784,
        256
      ],
      "id": "9682bd13-284f-46b8-a759-f3faac4864a1",
      "name": "Buscar_Sites_Unifi"
    },
    {
      "parameters": {
        "jsCode": "function cleanWans(wans) {\n  const cleanedWans = {};\n  for (const key in wans) {\n    if (Object.prototype.hasOwnProperty.call(wans, key)) {\n      const { ispInfo, externalIp, wanUptime } = wans[key];\n      cleanedWans[key] = {\n        name: ispInfo?.name,\n        externalIp,\n        wanUptime\n      };\n    }\n  }\n  return cleanedWans;\n}\n\nconst { data } = items[0].json;\n\nif (!data || !Array.isArray(data)) {\n  throw new Error('Entrada inválida: data.data ausente ou não é uma lista.');\n}\n\nreturn data.map(site => {\n  const wans = site.statistics?.wans || {};\n\n  // Usa a função cleanWans para limpar e reestruturar as interfaces\n  const cleanedWans = cleanWans(wans);\n\n  return {\n    json: {\n      hostId: site.hostId,\n      wans: cleanedWans\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -592,
        208
      ],
      "id": "8b4d6191-404f-4272-9673-f60e154b04ae",
      "name": "Limpar_Dados_WAN",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "url": "=https://api.ui.com/v1/hosts/{{$json[\"hostId\"]}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $('Variaveis').item.json.token_unifi }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -384,
        256
      ],
      "id": "f33e6bbd-da42-4055-b513-9b017eb319ca",
      "name": "Buscar_Hostname_do_Host"
    },
    {
      "parameters": {
        "jsCode": "const originalData = $items(\"Limpar_Dados_WAN\", 0, 0);\nconst hostnameData = $input.all();\n\nreturn hostnameData.map((hostItem, index) => {\n  const hostname = hostItem.json.data?.reportedState?.hostname || 'Nome não encontrado';\n  const state = hostItem.json.data?.reportedState?.state || 'Status não encontrado';\n  \n  if (!originalData[index]) {\n    return {\n      json: {\n        hostId: 'ID não encontrado',\n        hostname,\n        state,\n        wans: {}\n      }\n    };\n  }\n  \n  const siteData = originalData[index];\n  const hostId = siteData.json?.hostId || 'ID não encontrado';\n  const wans = siteData.json?.wans || {};\n  \n  return {\n    json: {\n      hostId,\n      hostname,\n      state,\n      wans\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        208
      ],
      "id": "c5d7c515-fd3b-420b-b3ae-002c29741455",
      "name": "Combinar_Hostname_e_WANs"
    },
    {
      "parameters": {
        "jsCode": "let allFilteredData = [];\nlet allTexts = [];\n\nitems.forEach(item => {\n  const hostname = item.json.hostname;\n  const state = item.json.state;\n  const wans = item.json.wans || {};\n  \n  // Se state diferente de connected, só mostra hostname e state\n  if (state !== 'connected') {\n    allFilteredData.push({\n      name: hostname,\n      state: state\n    });\n    \n    allTexts.push(`Gateway: ${hostname}\\n⚠️ Status: ${state}`);\n  } else {\n    // Se connected, filtra apenas por wanUptime <= 80\n    for (const [key, value] of Object.entries(wans)) {\n      if (value.wanUptime <= 80) {\n        let uptimeText = value.wanUptime;\n        \n        if (uptimeText >= 0 && uptimeText <= 9) {\n          uptimeText = \"Down\";\n        } else if (uptimeText >= 10 && uptimeText <= 80) {\n          uptimeText = `${uptimeText} (Perda de pacotes)`;\n        }\n        \n        allFilteredData.push({\n          name: hostname,\n          state: state,\n          wan: key,\n          isp: value.name,\n          wanUptime: value.wanUptime\n        });\n        \n        allTexts.push(`Gateway: ${hostname}\\n${key} (${value.name}): ${uptimeText}`);\n      }\n    }\n  }\n});\n\nif (allFilteredData.length === 0) {\n  return [{ json: { data: [] } }];\n}\n\nconst formattedText = `‼ Monitoramento de Links GW Unifi ‼\\n\\n${allTexts.join(\"\\n\\n\")}\\n\\n`;\n\nreturn {\n  json: {\n    data: allFilteredData,\n    text: formattedText\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        256
      ],
      "id": "0ae89b3d-6532-444c-b538-c8fc077eb94c",
      "name": "Filtrar_Problemas_e_Formatar_Alerta"
    },
