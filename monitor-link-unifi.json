      "name": "Mensagem_Ja_Foi_Enviada?"
    },
    {
      "parameters": {
        "jsCode": "// Verifica se passaram mais de 2 horas desde a última mensagem\nconst lastMessageData = $input.item.json;\nconst messageTimestamp = lastMessageData.data.messages.records[0].messageTimestamp;\n\n// Converte timestamp Unix para Date\nconst messageDate = new Date(messageTimestamp * 1000);\nconst now = new Date();\n\n// Calcula diferença em horas\nconst diffHours = (now - messageDate) / (1000 * 60 * 60);\n\nreturn {\n  json: {\n    deveEnviar: diffHours >= 2,\n    horasDesdeUltimaMensagem: Math.round(diffHours * 10) / 10\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
